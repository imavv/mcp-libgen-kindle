# Copy to .env.local for local dev. In production these live in
# Vercel project settings -> Environment Variables. Never commit real values.

# --- Auth for the MCP endpoint itself ---------------------------------------
# OAuth 2.1. This deployment is both the resource server (/api/mcp) and the
# authorization server (/api/oauth/*). See the README section "How the OAuth
# side is put together".

# Signs every authorization code and token. Never sent anywhere; rotating it
# invalidates every issued token at once, which is the only revocation this
# server has.   openssl rand -hex 32
OAUTH_SIGNING_KEY=

# Typed by you on the consent screen when a client asks for access. The consent
# page is publicly reachable, so this is the credential that actually matters.
OWNER_PASSWORD=

# Only needed if the public URL differs from the forwarded host Vercel reports
# (a custom domain fronted by something else). Issuer and audience are checked
# byte-for-byte, so a mismatch shows up as "token issuer ... is not ...".
OAUTH_ISSUER=

# The pre-OAuth static bearer token. Optional. While set, /api/mcp also accepts
# it — with every scope, no expiry, and in ?token= form it lands in access logs.
# Keep it until the OAuth connector works, then unset it. /selftest and
# npm run check use it, since curl has no browser to redirect through.
MCP_AUTH_TOKEN=

# --- Google Drive (OAuth2, personal Gmail) ----------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (application type: Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced by: npm run auth   (see README, step 2)
GOOGLE_REFRESH_TOKEN=
# Optional. Leave blank and the server creates/reuses a folder by name.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Kindle Library

# --- Send to Kindle ---------------------------------------------------------
# Must exactly match an address on your Amazon "Approved Personal Document
# E-mail List", or Amazon silently drops the message.
SENDER_EMAIL=you@gmail.com
# Treat this as semi-secret: anyone who knows it can push documents to your
# device if they can also spoof an approved sender. Keep it out of the repo.
KINDLE_EMAIL=yourname@kindle.com
# 16-char app password from myaccount.google.com/apppasswords (needs 2FA on).
# NOT your Google account password.
GMAIL_APP_PASSWORD=

# --- libgen -----------------------------------------------------------------
# Comma-separated, tried in order. First one that responds wins.
# Verified serving downloads. libgen.gs and library.lol were dropped after
# failing DNS resolution entirely — add them back if they return.
LIBGEN_MIRRORS=https://libgen.li,https://libgen.la,https://libgen.vg
